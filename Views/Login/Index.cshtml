@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-4">

            <div class="card shadow">

                <div class="card-header bg-dark text-white text-center">
                    <h3>BarberTech</h3>
                </div>

                <div class="card-body">

                    <form method="post" asp-action="Entrar">

                        <div class="mb-3">
                            <label>Usuário</label>

                            <input type="text"
                                   name="usuario"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Senha</label>

                            <input type="password"
                                   name="senha"
                                   class="form-control" />
                        </div>

                        <button class="btn btn-dark w-100">
                            Entrar
                        </button>

                    </form>

                    <p class="text-danger mt-3">
                        @ViewBag.Erro
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>
