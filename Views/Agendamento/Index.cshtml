@model BarberTech.Models.Agendamento

<h2>Agendamento</h2>

<form asp-action="Salvar" method="post">

    <div class="mb-3">
        <label>Nome do Cliente</label>
        <input asp-for="ClienteNome" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Serviço</label>

        <select asp-for="Servico" class="form-control">

            <option value="">Selecione</option>

            <option value="Corte">
                Corte
            </option>

            <option value="Barba">
                Barba
            </option>

            <option value="Sobrancelha">
                Sobrancelha
            </option>

        </select>
    </div>

    <div class="mb-3">
        <label>Data e Hora</label>
        <input asp-for="DataHora" type="datetime-local" class="form-control" />
    </div>

    <button type="submit" class="btn btn-dark">
        Agendar
    </button>

</form>