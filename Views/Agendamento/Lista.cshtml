@model List<BarberTech.Models.Agendamento>

<h2>Agendamentos</h2>

<table class="table table-dark table-striped">

    <thead>
        <tr>
            <th>Cliente</th>
            <th>Serviço</th>
            <th>Data</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.ClienteNome</td>

                <td>@item.Servico</td>

                <td>@item.DataHora</td>

                <td>

                    <a asp-action="Editar"
                       asp-route-id="@item.Id"
                       class="btn btn-warning">

                        Editar

                    </a>

                    <a asp-action="Excluir"
                       asp-route-id="@item.Id"
                       class="btn btn-danger">

                        Excluir

                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>